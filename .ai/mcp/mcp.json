{
  "mcpServers": {
    "laravel-boost-ai": {
      "command": "ddev",
      "args": [
        "exec",
        "php",
        "artisan",
        "boost:mcp"
      ]
    },
    "craft-cms-ai": {
      "command": "ddev",
      "args": [
        "exec",
        "php",
        "craft",
        "mcp:serve",
        "--user=admin"
      ]
    }
  }
}