{% extends "layouts/main" %}


{% block body %}
    <ul>
        {% for article in articles %}
            <li>
                <a href="{{ article.url }}?format=twig">
                    {{ article.title }}
                </a>
            </li>
        {% endfor %}
    </ul>

    <div class="mt-8">
        {{ articles.links()|raw }}
    </div>

{% endblock %}
