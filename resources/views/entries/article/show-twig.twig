{% extends "layouts/main" %}


{% block body %}


    <div class="prose prose-gray dark:prose-invert">
        <p class="font-semibold">
            {{ entry.teaser }}
        </p>

        {{ blade('components.layouts.meta', {entry}) }}

        {{ blade('components.blocks', {blocks: entry.contentBuilder.collect }) }}

        {# We need a wrapper here, because blade() does not support class based components #}
        {{ blade('components.twig.latest-articles', {entry}) }}

    </div>
{% endblock %}
